# Copy this file to .env and adjust as needed for local development.
# Nexa reads these as plain OS environment variables (see nexa_project/settings.py).

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
NEXA_SECRET_KEY=replace-this-with-a-long-random-string

# "True" for local development, "False" in production.
NEXA_DEBUG=True
